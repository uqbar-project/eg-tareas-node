{
  "name": "eg-tareas-node",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend con paginación para el ejemplo de tareas (NestJS)",
  "main": "dist/main.js",
  "scripts": {
    "start:dev": "nest start --watch",
    "start": "node dist/main.js",
    "build": "nest build",
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "clean": "rm -rf dist node_modules coverage",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@faker-js/faker": "10.6.0",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "date-fns": "4.4.0",
    "reflect-metadata": "0.2.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.6",
    "@nestjs/testing": "12.1.2",
    "@types/node": "26.6.4",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/ui": "5.0.3",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "supertest": "7.3.1",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "24.x"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc}": [
      "biome check --write --staged"
    ]
  }
}
